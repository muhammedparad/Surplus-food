# ==============================================================================
# Application & Server
# ==============================================================================
NODE_ENV=development
PORT=3000
APP_NAME=AuthPlatform
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000
ALLOWED_OAUTH_REDIRECT_URLS=http://localhost:3001/auth/callback,http://localhost:3000/docs
API_PREFIX=
TRUST_PROXY=false

# ==============================================================================
# Database (Supabase PostgreSQL / Local PostgreSQL)
# ==============================================================================
# Pooled connection URL (Supabase Transaction/Session pooler) used by the app at runtime
DATABASE_URL=postgresql://postgres:postgres@localhost:51214/auth_dev?sslmode=disable
# Direct non-pooled PostgreSQL URL used by Prisma migrations (especially on Supabase)
DIRECT_URL=postgresql://postgres:postgres@localhost:51214/auth_dev?sslmode=disable
# Set to true when connecting to managed PostgreSQL with TLS (e.g., Supabase in production)
DATABASE_SSL=false
# Set to true only when using self-signed certs in controlled dev environments (keep true in production!)
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# ==============================================================================
# JWT & Session Security
# ==============================================================================
# Generate strong 64-byte secrets in production: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change-this-development-access-secret-minimum-32-chars
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
COOKIE_SECRET=change-this-development-cookie-secret-minimum-32-chars
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
# Enable CSRF double-submit protection when using cookie-based auth
CSRF_PROTECTION_ENABLED=true

# ==============================================================================
# Authentication & Security Policies
# ==============================================================================
DEFAULT_USER_ROLE=customer
REQUIRE_EMAIL_VERIFICATION=true
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=true
EMAIL_VERIFICATION_EXPIRES_IN=24h
PASSWORD_RESET_EXPIRES_IN=1h
INVITATION_EXPIRES_IN=7d

# Feature toggles (reusability across SaaS projects)
ENABLE_ORGANIZATIONS=true
ENABLE_LOGIN_NOTIFICATIONS=false
ENABLE_MFA=false
ALLOWED_AUTH_PROVIDERS=local,google

# Rate limiting defaults
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60
AUTH_THROTTLE_TTL_MS=60000
AUTH_THROTTLE_LIMIT=10

# ==============================================================================
# Google OAuth 2.0 / OpenID Connect
# ==============================================================================
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ==============================================================================
# Email / SMTP
# ==============================================================================
SMTP_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Auth Platform <no-reply@example.com>"
